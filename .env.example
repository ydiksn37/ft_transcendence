# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
#  ft_transcendence — 環境変数テンプレート
#  コピー: cp .env.example .env
#  ※ .env は絶対に git commit しないこと
# ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

# 開発用の直接公開ポートはloopbackだけにbindする
DEV_BIND_ADDRESS=127.0.0.1

# ─── フロントエンド ───────────────────────────────────
FRONTEND_PORT=5173
VITE_WS_URL=https://localhost:8443

BACKEND_PORT=3000

# ─── データベース (PostgreSQL) ────────────────────────
POSTGRES_PORT=54320
POSTGRES_USER=transcendence
POSTGRES_DB=transcendence_db

# ─── Redis ────────────────────────────────────────────
REDIS_PORT=63790

# ─── 42 OAuth ─────────────────────────────────────────
FT_CLIENT_ID=
FT_CLIENT_SECRET=
FT_CALLBACK_URL=https://localhost:8443/api/auth/42/callback

# ─── Nginx ────────────────────────────────────────────
NGINX_PORT=8443
NGINX_HTTP_PORT=8080

# ─── CORS ─────────────────────────────────────────────
ALLOWED_ORIGINS=https://localhost:8443
