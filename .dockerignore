# ─── Node.js ───────────────────────────────────────────────────────────────
# ホストOS向けバイナリがAlpine Linux環境と競合するのを防ぐ
node_modules
apps/*/node_modules
packages/*/node_modules

# ─── ビルド成果物 ──────────────────────────────────────────────────────────
dist
apps/*/dist
packages/*/dist
.turbo

# ─── 環境変数・シークレット ────────────────────────────────────────────────
.env
.env.local
.env.*.local

# ─── Git ───────────────────────────────────────────────────────────────────
.git
.gitignore

# ─── ログ・キャッシュ ──────────────────────────────────────────────────────
*.log
npm-debug.log*
.npm

# ─── OS・エディタ生成ファイル ──────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode
.idea
